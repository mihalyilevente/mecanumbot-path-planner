<?xml version="1.0" ?>
<!--
  Mecanumbot for Gazebo Fortress, kept as simple as Nav2 needs: a body, the
  LD08 lidar and planar velocity control.

  Dimensions follow mecanumbot_description/urdf/mecanumbot.urdf
  (Fortuz/mecanumbot) and the Gazebo model in Fortuz/mecanumbot_remote. The
  model origin is mecanumbot/base_footprint, base_link sits 1 cm above it like
  in the URDF.

  The base is moved by VelocityControl, not by wheel contact, so the wheels are
  frictionless and only there for looks. Gazebo does not simulate mecanum
  rollers well, and Nav2 only cares about the resulting body velocity anyway.

  Odometry comes from OdometryPublisher and is exact (no drift).
-->
<sdf version="1.9">
  <model name="mecanumbot">
    <link name="base_link">
      <pose>0 0 0.01 0 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <pose>0 0 0.06 0 0 0</pose>
        <inertia>
          <ixx>0.04</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.04</iyy><iyz>0</iyz>
          <izz>0.04</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <pose>0 0 0.055 0 0 0</pose>
        <geometry><box><size>0.32 0.26 0.06</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <pose>0 0 0.055 0 0 0</pose>
        <geometry><box><size>0.32 0.26 0.06</size></box></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="tower_visual">
        <pose>0.09 0 0.12 0 0 0</pose>
        <geometry><box><size>0.11 0.22 0.08</size></box></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <!-- Grabbers, fixed in the closed position. They are part of the Nav2 footprint. -->
      <visual name="grabber_left_visual">
        <pose>0.224 0.070 0.024 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material>
      </visual>
      <visual name="grabber_right_visual">
        <pose>0.224 -0.070 0.024 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material>
      </visual>

      <!-- Wheels, visual only. -->
      <visual name="wheel_frontleft">
        <pose>0.064 0.1522 0.02345 -1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.033</radius><length>0.030</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.5 1</ambient><diffuse>0.1 0.1 0.5 1</diffuse></material>
      </visual>
      <visual name="wheel_backleft">
        <pose>-0.064 0.1522 0.02345 -1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.033</radius><length>0.030</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.5 1</ambient><diffuse>0.1 0.1 0.5 1</diffuse></material>
      </visual>
      <visual name="wheel_frontright">
        <pose>0.064 -0.1522 0.02345 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.033</radius><length>0.030</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.5 1</ambient><diffuse>0.1 0.1 0.5 1</diffuse></material>
      </visual>
      <visual name="wheel_backright">
        <pose>-0.064 -0.1522 0.02345 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.033</radius><length>0.030</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.5 1</ambient><diffuse>0.1 0.1 0.5 1</diffuse></material>
      </visual>
      <!-- Frictionless skids under the wheels so the body rests at the right height. -->
      <collision name="skid_frontleft">
        <pose>0.064 0.1522 0.02345 0 0 0</pose>
        <geometry><sphere><radius>0.033</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <collision name="skid_backleft">
        <pose>-0.064 0.1522 0.02345 0 0 0</pose>
        <geometry><sphere><radius>0.033</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <collision name="skid_frontright">
        <pose>0.064 -0.1522 0.02345 0 0 0</pose>
        <geometry><sphere><radius>0.033</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <collision name="skid_backright">
        <pose>-0.064 -0.1522 0.02345 0 0 0</pose>
        <geometry><sphere><radius>0.033</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>

      <!-- LD08 lidar, 0.122 m above base_link as in the URDF. -->
      <visual name="lidar_visual">
        <pose>0 0 0.122 0 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.030</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.122 0 0 0</pose>
        <ignition_frame_id>mecanumbot/base_scan</ignition_frame_id>
        <topic>/mecanumbot/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <plugin filename="ignition-gazebo-velocity-control-system"
            name="ignition::gazebo::systems::VelocityControl">
      <topic>/mecanumbot/cmd_vel</topic>
    </plugin>

    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>mecanumbot/odom</odom_frame>
      <robot_base_frame>mecanumbot/base_footprint</robot_base_frame>
      <odom_topic>/mecanumbot/odom</odom_topic>
      <tf_topic>/mecanumbot/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
