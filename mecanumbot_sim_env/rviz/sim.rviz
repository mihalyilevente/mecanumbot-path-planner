Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: map
      Alpha: 1
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.4
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.5
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /mecanumbot/scan
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Depth: 5
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Style: Points
      Size (Pixels): 4
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Color: 0; 255; 120
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Topic:
        Value: /plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Color: 31; 119; 180
      Line Style: Billboards
      Line Width: 0.04
      Alpha: 1
      Pose Style: None
    - Class: rviz_default_plugins/Path
      Name: Local plan
      Enabled: true
      Topic:
        Value: /local_plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Color: 255; 127; 14
      Line Style: Lines
      Line Width: 0.03
      Alpha: 1
      Pose Style: None
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /mecanumbot/odom
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 40
      X: 0
      Y: 0
Window Geometry:
  Width: 1400
  Height: 850
