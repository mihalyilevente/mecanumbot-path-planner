<?xml version="1.0"?>
<package format="3">
  <name>mecanumbot_planner_ui</name>
  <version>0.1.0</version>
  <description>Browser UI for selecting Nav2 planner criteria, visualising paths, and driving the Mecanumbot.</description>
  <maintainer email="fahradnamazov@gmail.com">Fahrad Namazov</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>mecanumbot_sim_env</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
